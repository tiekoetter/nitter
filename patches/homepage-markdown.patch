diff --git a/src/views/home.nim b/src/views/home.nim
new file mode 100644
--- /dev/null
+++ b/src/views/home.nim
@@ -0,0 +1,21 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+import markdown
+import karax/[karaxdsl, vdom]
+
+var homeHtml: string
+
+proc initHomePage*(path: string) =
+  if path.len == 0:
+    return
+
+  try:
+    homeHtml = markdown(readFile(path))
+  except IOError:
+    stderr.write "Custom home page Markdown file not found: " & path & "\n"
+    stderr.flushFile
+    homeHtml = "<h1>Custom home page unavailable</h1>" &
+               "<p>The configured Markdown file could not be read.</p>"
+
+proc renderHomePage*(): VNode =
+  buildHtml(tdiv(class="overlay-panel custom-homepage")):
+    verbatim homeHtml
