+ARG TARGETPLATFORM
 
 ARG NITTER_UPSTREAM_DATE
 ARG NITTER_UPSTREAM_HASH
@@ -10,19 +15,28 @@ ENV NITTER_UPSTREAM_HASH=${NITTER_UPSTREAM_HASH}
