 # SPDX-License-Identifier: AGPL-3.0-only
-import os, strformat
+import os, strutils, strformat
 import karax/[karaxdsl, vdom]
 
+# Build metadata can be overridden with Nim defines. Environment variables are
+# retained for compatibility with the wrapper's Docker build arguments.
 const
-  date = staticExec("sh -c 'if [ -n \"$NITTER_UPSTREAM_DATE\" ]; then printf %s \"$NITTER_UPSTREAM_DATE\"; else git show -s --format=\"%cd\" --date=format:\"%Y.%m.%d\"; fi'")
-  hash = staticExec("sh -c 'if [ -n \"$NITTER_UPSTREAM_HASH\" ]; then printf %s \"$NITTER_UPSTREAM_HASH\"; else git show -s --format=\"%h\"; fi'")
-  forkHash = staticExec("sh -c 'printf %s \"$NITTER_FORK_HASH\"'")
-  forkRepo = staticExec("sh -c 'if [ -n \"$NITTER_FORK_REPOSITORY\" ]; then printf %s \"$NITTER_FORK_REPOSITORY\"; else printf %s tiekoetter/nitter; fi'")
+  gitHash {.strdefine.} = ""
+  gitDate {.strdefine.} = ""
+  gitForkHash {.strdefine.} = ""
+  gitForkRepo {.strdefine.} = ""
+
+proc buildMeta(definedValue, envName, command: string;
+               fallback="unknown"): string {.compileTime.} =
+  if definedValue.len > 0:
+    return definedValue
+
+  let envValue = getEnv(envName)
+  if envValue.len > 0:
+    return envValue
+
+  if command.len > 0:
+    let res = gorgeEx(command)
+    if res.exitCode == 0:
+      return res.output.strip()
+
+  fallback
+
+const
+  date = buildMeta(gitDate, "NITTER_UPSTREAM_DATE",
+                   "git show -s --format=\"%cd\" --date=format:\"%Y.%m.%d\"")
+  hash = buildMeta(gitHash, "NITTER_UPSTREAM_HASH",
+                   "git show -s --format=\"%h\"")
+  forkHash = buildMeta(gitForkHash, "NITTER_FORK_HASH", "", "")
+  forkRepo = buildMeta(gitForkRepo, "NITTER_FORK_REPOSITORY", "",
+                       "tiekoetter/nitter")
   link = "https://github.com/zedeus/nitter/commit/" & hash
   forkLink = "https://github.com/" & forkRepo & "/commit/" & forkHash
   version = &"{date}-{hash[0 .. 6]}"
